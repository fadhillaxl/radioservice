# /etc/udev/rules.d/99-icom-ic9700.rules
# Udev rules untuk Transceiver Icom IC-9700
# - Silicon Labs CP2102 Dual USB to UART Bridge (VID: 10c4, PID: ea60)
# - Texas Instruments PCM2901 USB Audio CODEC   (VID: 08bb, PID: 2901)

# 1. Icom IC-9700 Dual USB UART (CP210x - 10c4:ea60)
# Nonaktifkan USB autosuspend agar koneksi CAT/CI-V tidak terputus
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="10c4", ATTR{idProduct}=="ea60", ATTR{power/control}="on"

# Set permission & group dialout untuk perangkat ttyUSB milik IC-9700
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE="0666", GROUP="dialout"

# Symlink tambahan khusus berdasarkan suffix serial Icom IC-9700 (Port A = CI-V/CAT, Port B = Data/GPS)
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="*IC-9700*A", SYMLINK+="icom-ic9700-cat"
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="*IC-9700*B", SYMLINK+="icom-ic9700-data"

# 2. Icom IC-9700 Internal USB Audio CODEC (TI PCM2901 - 08bb:2901)
# Nonaktifkan USB autosuspend pada perangkat audio USB
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="08bb", ATTR{idProduct}=="2901", ATTR{power/control}="on"

# Set permission & group audio untuk node ALSA (/dev/snd/*)
SUBSYSTEM=="sound", ATTRS{idVendor}=="08bb", ATTRS{idProduct}=="2901", MODE="0666", GROUP="audio"
